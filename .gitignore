node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
.DS_Store
test-results/
playwright-report/

# Personal notes stay out of the public repo.
LEGAL-AND-DISTRIBUTION.md

# Env files — NEVER commit secrets (this repo is public). Real keys live in
# .env, which is ignored here; .env.example is a committed, secret-free
# template.
.env
.env.*
!.env.example

# Companion pictures and their sidecar captions are local-only — supply your
# own under public/companions/<id>/. Nothing in here is committed; the .gitkeep
# just keeps the directory around.
/public/companions/*
!/public/companions/.gitkeep

# Generated at build time by scripts/generate-companion-pictures.mjs from the
# images under public/companions/ — a build artifact, regenerated by the
# pre-hooks (pre{dev,build,typecheck,lint,test}), so it's kept out of git.
/src/lib/companions/companion-pictures.generated.ts
