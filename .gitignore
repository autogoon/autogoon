node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
.DS_Store
test-results/
playwright-report/

# Personal notes stay out of the public repo.
/notes/

# Env files — NEVER commit secrets (this repo is public). Real keys live in
# .env, which is ignored here; .env.example is a committed, secret-free
# template.
.env
.env.*
!.env.example

# Legacy picture location (pre-goonpacks) — never commit anything here.
/public/companions/*

# Local goonpack sources (media + manifests) — personal content, never
# committed. Zip a pack directory's contents to import it in the app. The one
# exception is the committed, deliberately media-free example pack
# (goonpacks/elise/) — and even there, media stays local.
/goonpacks/*
!/goonpacks/elise/
/goonpacks/elise/media/

# The inference corpus — personal media, the ground truth labelled against it
# and every experiment's output. Never committed; the layout is in
# docs/2026-08-02-inference-ui-spec.md.
/inference-corpus/
