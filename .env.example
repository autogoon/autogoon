# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — NEVER put real keys in a committed file (public repo).
#
# All of these are read server-side only (Next API routes / server components).
# None are NEXT_PUBLIC_*, so no secret is ever shipped to the browser bundle.

# ElevenLabs — used by server routes to mint short-lived realtime-STT tokens
# and to proxy/stream text-to-speech. The raw key stays on the server.
ELEVENLABS_API_KEY=

# The OpenAI-compatible chat endpoint the app talks to (the LLMClient targets
# this shape). Ollama exposes one at /v1; point it at wherever Ollama runs
# (localhost when it's on the same machine).
LLM_URL=http://localhost:11434/v1

# The model to request — a companion's Ollama model card name. Each companion is
# its own card built on a shared Cydonia 24B base; see COMPANIONS.md for the setup
# and how to build them. Smoke-test a card directly with `ollama run <name>`.
LLM_MODEL=elise
