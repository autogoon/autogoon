# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER put real keys in a committed file (public repo).
#
# None is NEXT_PUBLIC_*, so nothing here is inlined into a build.
#
# The app takes its provider keys from one place or the other, never both. With
# keys here, the dev server hands them to the browser at load
# (src/app/api/dev/keys), Settings shows them locked, and nothing is written to
# the browser. With none here — every build, since no build serves that route —
# you paste your own into Settings and they are kept in that browser.
#
# That route does not check who is asking, and the dev server binds 0.0.0.0, so
# while it runs, anything that can reach it on your network can read these keys.
#
# The goonpack scripts read the same variables directly.

# Companions: the ElevenLabs key it hears and speaks with (realtime STT tokens
# and text-to-speech). The other play modes call nothing.
ELEVENLABS_API_KEY=

# Companions and the goonpack scripts: the OpenAI-compatible chat endpoint. We
# use OpenRouter; keep the default unless you point at another one. The model
# itself is not here — it is chosen under Settings → Companion model, and the
# scripts take MODEL below.
LLM_URL=https://openrouter.ai/api/v1

# Companions and the goonpack scripts: the OpenRouter API key.
OPENROUTER_API_KEY=

# Optional, scripts only: which model the goonpack scripts call.
# `goonpack:describe` and `goonpack:describe-missing` default to a vision model;
# `goonpack:summarise` to the named experiment's text model, or the app's
# default companion model without one. MODEL overrides all of them. The vision
# candidates are listed at the top of scripts/describe-image.ts.
#   e.g. MODEL=google/gemini-2.5-flash
MODEL=

# Optional, dev server only: use the app from another device on your network (a
# phone). Next blocks cross-origin dev asset requests, which leaves the page
# visible but nothing clickable — list the dev machine's LAN origin(s) here
# (comma-separated) and restart the dev server. Not a secret; just
# machine-specific, so it lives in .env rather than the repo.
#   e.g. DEV_ALLOWED_ORIGINS=192.168.1.100
DEV_ALLOWED_ORIGINS=
