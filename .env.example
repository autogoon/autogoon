# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER put real keys in a committed file (public repo).
#
# None of these is read in the browser, and none is NEXT_PUBLIC_*, so no secret
# is ever shipped to the browser bundle.

# Required for Companions; the other play modes never call it.
# ElevenLabs — used by server routes to mint short-lived realtime-STT tokens
# and to proxy/stream text-to-speech.
ELEVENLABS_API_KEY=

# Required for Companions. The chat endpoint the proxy route forwards to — we
# use OpenRouter; keep the default unless you point at another OpenAI-compatible
# one. Each companion picks their own model (see src/lib/companions).
LLM_URL=https://openrouter.ai/api/v1

# Required for Companions.
# OpenRouter API key — the /api/llm proxy route adds it as a Bearer header.
OPENROUTER_API_KEY=

# Companion access gate — a comma-separated list of shared "access IDs" that
# unlock the Companions feature (and are REQUIRED by its paid API routes). Hand
# out different IDs to different people; revoke one by deleting it here. The gate
# is FAIL-CLOSED in builds/deploys: if this is empty/unset, Companions is hidden
# and its paid routes reject everything. Must be set in the deploy's env.
# The dev server (`npm run dev`) is the exception: the gate is open there, no ID
# needed — note dev binds 0.0.0.0, so your LAN can reach the paid routes too.
#   e.g. COMPANIONS_ACCESS_IDS=alice-7f3a,bob-9c21
COMPANIONS_ACCESS_IDS=

# Optional, dev server only: use the app from another device on your network (a
# phone). Next blocks cross-origin dev asset requests, which leaves the page
# visible but nothing clickable — list the dev machine's LAN origin(s) here
# (comma-separated) and restart the dev server. Not a secret; just
# machine-specific, so it lives in .env rather than the repo.
#   e.g. DEV_ALLOWED_ORIGINS=192.168.1.100
DEV_ALLOWED_ORIGINS=
