{
  "name": "keyword-spotting",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "goonpack:describe": "tsx --env-file-if-exists=.env scripts/describe-image.ts",
    "goonpack:describe-missing": "tsx --env-file-if-exists=.env scripts/describe-missing.ts",
    "goonpack:summarise": "tsx --env-file-if-exists=.env scripts/summarise-pack.ts",
    "goonpack:build": "tsx scripts/goonpack-build.ts",
    "experiment:run": "tsx --env-file-if-exists=.env scripts/experiment-run.ts",
    "experiment:run:outdated": "tsx --env-file-if-exists=.env scripts/experiment-run.ts --outdated",
    "llm:benchmark": "tsx --env-file-if-exists=.env scripts/llm-benchmark.ts",
    "llm:benchmark:wipe": "tsx scripts/llm-benchmark.ts --wipe",
    "docs:sweep": "tsx scripts/md-sweep.ts",
    "dev": "next dev -H 0.0.0.0 --port 8931",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"goonpacks/**/*.{md,json}\" \"*.{ts,js,mjs,json,md}\" \"docs/**/*.md\" \"roadmap/**/*.md\" \"modes/**/*.md\" \".claude/**/*.md\" \"scripts/md-sweep-briefs/*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.58.0",
    "@radix-ui/react-select": "^2.3.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.500.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "openai": "^6.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "vosk-browser": "^0.0.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.4.1",
    "@next/eslint-plugin-next": "^16.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.50.0"
  }
}
